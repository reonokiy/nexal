# ── Database ─────────────────────────────────────────────
DATABASE_URL=postgres://user:password@host:5432/nexal

# ── Gateway ──────────────────────────────────────────────
# NEXAL_GATEWAY_URL=https://nexal.fly.dev
# NEXAL_GATEWAY_ACCESS_KEY=access-key
# NEXAL_GATEWAY_SECRET_KEY=secret-key

# ── Model / Provider Settings ────────────────────────────
# Model, provider, auth, channel, and tool API key settings are stored in
# Postgres settings KV. Configure them from the Web UI or slash commands such
# as /model, /apikey, /providers, and /settings.

# ── Telegram ─────────────────────────────────────────────
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF
# TELEGRAM_ALLOW_FROM=user_id_1,username_2
# TELEGRAM_ALLOW_CHATS=chat_id_1,chat_id_2

# ── Bot persona ─────────────────────────────────────────
# BOT_NAME=nexal

# ── Sandbox ──────────────────────────────────────────────
# SANDBOX_IMAGE=ghcr.io/reonokiy/nexal-sandbox:python3.13-debian13
# SANDBOX_RUNTIME=              # e.g. krun for microVM isolation (requires libkrun)
# SANDBOX_NETWORK_ENABLED=false
# SANDBOX_WORKSPACE_READ_ONLY=false

# ── Message timing ───────────────────────────────────────
# MESSAGE_DEBOUNCE_SECONDS=1
# MESSAGE_DELAY_SECONDS=10
# ACTIVE_TIME_WINDOW_SECONDS=60

# ── Tape Storage (Supabase S3-compatible) ─────────────────
# STORAGE_PROVIDER=s3
# STORAGE_S3_ENDPOINT=https://<project>.storage.supabase.co/storage/v1/s3
# STORAGE_S3_BUCKET=tape-files
# STORAGE_S3_ACCESS_KEY=your-s3-access-key
# STORAGE_S3_SECRET_KEY=your-s3-secret-key
# STORAGE_S3_REGION=eu-central-1
# STORAGE_MAX_INLINE_SIZE=102400

# ── Supabase Auth (optional) ────────────────────────────
# NEXAL_AUTH_ENABLED=true
# NEXAL_SUPABASE_URL=https://<project>.supabase.co
