{
  "name": "@nexal/tape",
  "version": "0.1.0",
  "description": "Append-only fact tape — zero-dependency types and utilities",
  "type": "module",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./strategies": {
      "types": "./src/strategies.ts",
      "import": "./src/strategies.ts"
    }
  }
}
