{
  "name": "nexal",
  "version": "0.1.0",
  "description": "nexal multi-channel bot on top of pi-agent-core and pi-ai",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/*",
    "web"
  ],
  "bin": {
    "nexal": "./src/cli.ts"
  },
  "scripts": {
    "start": "bun run src/cli.ts",
    "dev": "bun --watch run src/cli.ts",
    "chat": "bun run src/scripts/chat-cli.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.90.0",
    "@mariozechner/pi-agent-core": "^0.67.1",
    "@mariozechner/pi-ai": "^0.67.1",
    "@msgpack/msgpack": "^3.1.3",
    "@nexal/tape": "workspace:*",
    "@nexal/transport": "workspace:*",
    "@supabase/supabase-js": "^2.106.1",
    "chalk": "^5.6.0",
    "consola": "^3.4.2",
    "drizzle-orm": "^0.45.2",
    "jose": "^6.2.3",
    "uuidv7": "^1.2.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.6.0"
  }
}
